# Port du serveur Express
PORT=5000

# Connexion MongoDB (local ou Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/findora

# Secret utilisé pour signer les JWT (chaîne aléatoire longue)
JWT_SECRET=change-me-to-a-long-random-string

# Clé API Cohere (https://dashboard.cohere.com/api-keys) - utilisée pour la recherche produits IA
COHERE_API_KEY=

# OAuth Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Compte Gmail utilisé pour l'envoi d'emails (reset de mot de passe, réponses contact)
# EMAIL_PASS doit être un "mot de passe d'application" Gmail, pas le mot de passe du compte
EMAIL_USER=
EMAIL_PASS=
